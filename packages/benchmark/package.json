{
  "name": "@0sec/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./kernel-weaponization-collector": {
      "types": "./dist/kernel-weaponization-collector.d.ts",
      "default": "./dist/kernel-weaponization-collector.js"
    },
    "./windows-research-collector": {
      "types": "./dist/windows-research-collector.d.ts",
      "default": "./dist/windows-research-collector.js"
    },
    "./windows-lpe-corpus": {
      "types": "./dist/windows-lpe-corpus.d.ts",
      "default": "./dist/windows-lpe-corpus.js"
    },
    "./windows-lpe-paired-corpus": {
      "types": "./dist/windows-lpe-paired-corpus.d.ts",
      "default": "./dist/windows-lpe-paired-corpus.js"
    },
    "./windows-lpe-opaque-projection": {
      "types": "./dist/windows-lpe-opaque-projection.d.ts",
      "default": "./dist/windows-lpe-opaque-projection.js"
    },
    "./windows-ioctl-benchmark-observation": {
      "types": "./dist/windows-ioctl-benchmark-observation.d.ts",
      "default": "./dist/windows-ioctl-benchmark-observation.js"
    },
    "./windows-ioctl-foxguard-baseline": {
      "types": "./dist/windows-ioctl-foxguard-baseline.d.ts",
      "default": "./dist/windows-ioctl-foxguard-baseline.js"
    },
    "./msrc-windows-lpe-inventory": {
      "types": "./dist/msrc-windows-lpe-inventory.d.ts",
      "default": "./dist/msrc-windows-lpe-inventory.js"
    },
    "./msrc-windows-lpe-capability-promotion": {
      "types": "./dist/msrc-windows-lpe-capability-promotion.d.ts",
      "default": "./dist/msrc-windows-lpe-capability-promotion.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.typecheck.json && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "bench": "tsx src/runner.ts",
    "bench:quick": "tsx src/runner.ts --depth quick",
    "bench:agentic": "tsx src/runner.ts --agentic --runtime auto",
    "bench:agentic:api": "tsx src/runner.ts --agentic --runtime api",
    "cybergym": "tsx src/cybergym-runner.ts",
    "cybergym:json": "tsx src/cybergym-runner.ts --json",
    "cybergym:stratify": "tsx src/cybergym-stratify.ts",
    "xbow": "tsx src/xbow-runner.ts",
    "xbow:dry": "tsx src/xbow-runner.ts --dry-run",
    "xbow:quick": "tsx src/xbow-runner.ts --limit 5",
    "xbow:agentic": "tsx src/xbow-runner.ts --agentic",
    "xbow:ensemble": "tsx src/xbow-runner.ts --agentic --runtime api --models anthropic/claude-sonnet-4.6,google/gemini-2.5-pro,openai/o3",
    "xbow:whitebox": "tsx src/xbow-runner.ts --agentic --white-box",
    "xbow:jit-skills-ab": "tsx src/jit-skills-ab.ts",
    "xbow:python-exec-ab": "tsx src/python-exec-ab.ts",
    "autopenbench": "tsx src/autopenbench-runner.ts",
    "autopenbench:dry": "tsx src/autopenbench-runner.ts --dry-run",
    "cybench": "tsx src/cybench-runner.ts",
    "cybench:dry": "tsx src/cybench-runner.ts --dry-run",
    "cybench:quick": "tsx src/cybench-runner.ts --limit 5",
    "cybench:10": "tsx src/cybench-runner.ts --limit 10",
    "bountybench": "tsx src/bountybench-runner.ts",
    "bountybench:dry": "tsx src/bountybench-runner.ts --dry-run",
    "bountybench:quick": "tsx src/bountybench-runner.ts --limit 10",
    "bountybench:detect": "tsx src/bountybench-runner.ts --task-type detect",
    "bountybench:exploit": "tsx src/bountybench-runner.ts --task-type exploit",
    "bountybench:patch": "tsx src/bountybench-runner.ts --task-type patch",
    "hackbench": "tsx src/hackbench-runner.ts",
    "hackbench:dry": "tsx src/hackbench-runner.ts --dry-run",
    "hackbench:agentic": "tsx src/hackbench-runner.ts --agentic",
    "argus": "tsx src/argus-runner.ts",
    "argus:dry": "tsx src/argus-runner.ts --dry-run",
    "argus:quick": "tsx src/argus-runner.ts --limit 10",
    "argus:agentic": "tsx src/argus-runner.ts --agentic",
    "htb": "tsx src/htb-runner.ts",
    "htb:dry": "tsx src/htb-runner.ts --dry-run",
    "htb:quick": "tsx src/htb-runner.ts --limit 5",
    "htb:tier1": "tsx src/htb-runner.ts --tier 1",
    "htb:challenges": "tsx src/htb-challenges-runner.ts",
    "htb:challenges:dry": "tsx src/htb-challenges-runner.ts --dry-run",
    "htb:challenges:web": "tsx src/htb-challenges-runner.ts --category web",
    "htb:challenges:quick": "tsx src/htb-challenges-runner.ts --category web --difficulty easy --limit 10",
    "htb:challenges:static": "tsx src/htb-challenges-runner.ts --challenge-type static",
    "htb:challenges:dynamic": "tsx src/htb-challenges-runner.ts --challenge-type dynamic",
    "portswigger": "tsx src/portswigger-runner.ts",
    "portswigger:dry": "tsx src/portswigger-runner.ts --dry-run",
    "portswigger:quick": "tsx src/portswigger-runner.ts --limit 10",
    "portswigger:apprentice": "tsx src/portswigger-runner.ts --difficulty Apprentice",
    "portswigger:sqli": "tsx src/portswigger-runner.ts --category 'SQL injection'",
    "portswigger:xss": "tsx src/portswigger-runner.ts --category 'Cross-site scripting'",
    "picoctf": "tsx src/picoctf-runner.ts",
    "picoctf:dry": "tsx src/picoctf-runner.ts --dry-run",
    "picoctf:quick": "tsx src/picoctf-runner.ts --limit 10",
    "picoctf:web": "tsx src/picoctf-runner.ts --category web",
    "harmbench": "tsx src/harmbench-runner.ts",
    "harmbench:vulnerable": "tsx src/harmbench-runner.ts --test-target vulnerable",
    "harmbench:safe": "tsx src/harmbench-runner.ts --test-target safe",
    "harmbench:quick": "tsx src/harmbench-runner.ts --test-target vulnerable --limit 20",
    "harmbench:json": "tsx src/harmbench-runner.ts --json",
    "adversarial-tool-misuse": "tsx src/adversarial-tool-misuse-runner.ts",
    "adversarial-indirect-prompt-injection": "tsx src/adversarial-indirect-prompt-injection-runner.ts",
    "adversarial-persistence": "tsx src/adversarial-persistence-runner.ts",
    "windows-research": "tsx src/windows-research-collector.ts",
    "windows-lpe-corpus": "tsx src/windows-lpe-corpus.ts",
    "windows-lpe-corpus:contract": "tsx src/windows-lpe-corpus.ts --input fixtures/windows-lpe-corpus-contract-v1.json",
    "windows-lpe-paired-corpus": "tsx src/windows-lpe-paired-corpus.ts",
    "windows-lpe-paired-corpus:contract": "tsx src/windows-lpe-paired-corpus.ts --input fixtures/windows-lpe-paired-corpus-contract-v2.json --development-labels fixtures/windows-lpe-paired-labels-development-contract-v2.json --holdout-labels fixtures/windows-lpe-paired-labels-holdout-contract-v2.json",
    "msrc-windows-lpe-inventory": "tsx src/msrc-windows-lpe-inventory.ts",
    "test:windows-research": "vitest run src/windows-lpe-corpus.test.ts src/windows-lpe-paired-corpus.test.ts src/windows-lpe-opaque-projection.test.ts src/windows-ioctl-benchmark-observation.test.ts src/windows-ioctl-foxguard-baseline.test.ts src/msrc-windows-lpe-inventory.test.ts src/msrc-windows-lpe-capability-promotion.test.ts src/windows-research-collector.test.ts",
    "npm-bench": "tsx src/npm-bench.ts",
    "npm-bench:json": "tsx src/npm-bench.ts --json",
    "consolidate-xbow": "tsx src/scripts/consolidate-xbow.ts",
    "compare:xbow": "tsx src/compare-xbow.ts",
    "report": "tsx src/report.ts",
    "triage-data": "tsx src/triage-data-collector.ts",
    "triage-data:results": "tsx src/triage-data-collector.ts --results results/xbow-latest.json --output results/triage-data-latest.jsonl",
    "test": "vitest run"
  },
  "dependencies": {
    "@0sec/core": "workspace:*",
    "@0sec/shared": "workspace:*",
    "@0sec/test-targets": "workspace:*",
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
