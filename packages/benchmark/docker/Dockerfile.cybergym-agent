# syntax=docker/dockerfile:1.7
#
# Reproducible CyberGym agent image. The benchmark harness, task corpus, oracle,
# and credentials are mounted at runtime; none are baked into this image.
FROM node:24.5.0-bookworm

ARG DEBIAN_FRONTEND=noninteractive

ENV CI=1 \
    NODE_ENV=production \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      binutils \
      build-essential \
      ca-certificates \
      clang \
      cmake \
      file \
      gdb \
      git \
      make \
      ninja-build \
      pkg-config \
      python3 \
      tar \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /opt/pwnkit

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY scripts ./scripts
COPY assets ./assets
COPY docs ./docs
COPY packages ./packages
COPY test-targets ./test-targets
COPY LICENSE README.md ./

RUN pnpm install --frozen-lockfile && pnpm build

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin agent \
    && mkdir -p /results \
    && chown agent:agent /results

USER agent

ENTRYPOINT ["pnpm", "--filter", "@pwnkit/benchmark", "cybergym"]
