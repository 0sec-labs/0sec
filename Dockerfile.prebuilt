# syntax=docker/dockerfile:1.7
#
# 0sec-cli runtime image from a prebuilt ./dist bundle.
#
# This is the publish path for environments where rebuilding the dashboard
# bundle inside Docker is unstable. The bundle is still produced by
# `pnpm build` before this image is built.
#
# Build context MUST be the verified ./dist directory (not the repo root):
#   docker build -f Dockerfile.prebuilt -t 0sec:prebuilt ./dist
# This ensures the image receives only the pre-built bundle and its
# externalized dependencies without weakening .dockerignore exclusions
# (which exclude dist/ from the normal source-build Dockerfile context).

FROM node:24-bookworm AS node-runtime

FROM ubuntu:24.04 AS runtime

ARG INSTALL_SECLISTS=0
ARG DEBIAN_FRONTEND=noninteractive

ENV NODE_ENV=production \
    0SEC_DOCKER=1 \
    PATH=/usr/local/bin:/usr/bin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget gnupg jq git unzip xz-utils \
        ripgrep \
        skopeo \
        python3 python3-requests python3-bs4 \
        sqlmap nmap nikto gobuster hydra john ffuf wfuzz \
        whatweb wafw00f dirb \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN if [ "$INSTALL_SECLISTS" = "1" ]; then \
        apt-get update && apt-get install -y --no-install-recommends seclists \
        && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app

# Build context must be the verified ./dist directory (not the repo root).
# This ensures the prebuilt image receives only the pre-built bundle and
# its externalized dependencies, without weakening the source-build
# .dockerignore that excludes dist/ from the normal Dockerfile context.
COPY . /app/dist

WORKDIR /app/dist
RUN npm ci --omit=dev --ignore-scripts

RUN ln -s /app/dist/0sec.js /usr/local/bin/0sec \
    && ln -s /app/dist/0sec.js /usr/local/bin/0 \
    && chmod +x /app/dist/0sec.js

RUN mkdir -p /work \
    && chown -R ubuntu:ubuntu /work /app/dist \
    && chmod -R a+rX /app/dist
USER ubuntu
WORKDIR /work

ENTRYPOINT ["node", "/app/dist/0sec.js"]
CMD ["--help"]
