{
  "name": "0sec",
  "type": "module",
  "version": "0.13.0",
  "description": "Open-source security research harness for authorized targets.",
  "bin": {
    "0sec": "dist/0sec.js",
    "0": "dist/0sec.js"
  },
  "files": [
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "README.md",
    "package.json",
    "dist"
  ],
  "scripts": {
    "build": "pnpm -r exec rm -f tsconfig.tsbuildinfo && pnpm --filter @0sec/shared build && pnpm --filter @0sec/db --filter @0sec/templates build && pnpm --filter '!@0sec/docs' -r build && pnpm run build:bundle",
    "build:bundle": "node ./scripts/bundle-cli.mjs",
    "build:docs": "pnpm --filter @0sec/docs build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm --filter '!@0sec/docs' -r exec tsc --noEmit",
    "test": "pnpm test:public",
    "test:public": "pnpm --filter @0sec/core test && pnpm --filter @0sec/test-targets test && pnpm --filter 0sec-cli exec vitest run src/commands/__tests__/scan.test.ts src/commands/__tests__/bench.test.ts src/utils/update-check.test.ts && pnpm test:docker-contract && pnpm test:runtime-lock && pnpm test:launcher && pnpm test:installer && pnpm test:public-source-export",
    "test:docker-contract": "node --test scripts/docker-contract.test.mjs",
    "test:runtime-lock": "node --test scripts/runtime-lock.test.mjs",
    "test:launcher": "node --test scripts/npm-launcher/launcher.test.mjs",
    "test:installer": "node --test scripts/install.test.mjs",
    "test:public-source-export": "node --test scripts/create-public-source-export.test.mjs",
    "export:public-source": "node scripts/create-public-source-export.mjs",
    "bench": "pnpm --filter @0sec/benchmark bench",
    "bench:quick": "pnpm --filter @0sec/benchmark bench:quick",
    "consolidate-xbow": "pnpm --filter @0sec/benchmark consolidate-xbow",
    "clean": "pnpm -r clean",
    "vulnerable": "PORT=43100 pnpm --filter @0sec/test-targets vulnerable",
    "safe": "PORT=43101 pnpm --filter @0sec/test-targets safe"
  },
  "keywords": [
    "ai",
    "application-security",
    "mcp",
    "owasp",
    "security",
    "red-team",
    "llm",
    "prompt-injection"
  ],
  "author": "0sec Labs",
  "homepage": "https://0.security",
  "bugs": {
    "url": "https://0.security/contact"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0sec-labs/0sec.git"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@types/pdfkit": "^0.13.9",
    "drizzle-orm": "^0.45.2",
    "node-sqlite3-wasm": "^0.8.55",
    "pdfkit": "^0.15.2",
    "tree-sitter": "0.21.1",
    "tree-sitter-c": "0.21.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.0"
    }
  }
}
