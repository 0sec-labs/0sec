---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
---

{Astro.url.pathname !== '/' ? <DefaultHero /> : (
  <section class="docs-hero" aria-labelledby="_top">
    <div class="docs-hero-copy">
      <span class="docs-preview-label">Research Preview</span>
      <h1 id="_top" data-page-title>Hack any software<br />before attackers do.</h1>
      <p>Your self-improving cybersecurity team.</p>
      <p>Coming to 0sec Cloud: open cybersecurity models and 0sec-curated options through one connection and inference-credit balance, without separate supplier accounts.</p>
      <div class="docs-hero-actions">
        <LinkButton href="/getting-started/#hosted-models-draft" icon="right-arrow">Connect to 0sec Cloud</LinkButton>
        <LinkButton href="/getting-started/#use-my-own-api-key" variant="secondary">Use my own API key</LinkButton>
      </div>
    </div>
  </section>
)}
