dataset-out/
# M6 #34 — negative-results machine log (operator-local, append-only)
*.negatives.ndjson
negatives.ndjson
# M6 #33 — benchmark crash artifacts (results.ndjson IS tracked as the record)
benchmarks/fuzzbench/out/

# core dumps from crash/oracle runs
core
core.*

# qemu-user core dumps + pyghidra scratch projects
qemu_*.core
*_ghidra/

# Binarygym materialized task binaries (built from cve2026 sources at runtime)
benchmarks/binarygym/tasks/
# Binarygym ARVO materialized targets (GPL/LGPL binaries — recipe-only, never committed)
benchmarks/binarygym/tasks-arvo/
uv.lock

# Access-controlled Windows artifact CAS (BYOVD binaries) — private moat, never committed.
private/
