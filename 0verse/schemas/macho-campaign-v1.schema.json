{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0sec.ai/schemas/0verse/macho-campaign-v1.schema.json",
  "title": "0verse Apple Mach-O campaign manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "target", "control", "coordinator", "worker", "hardware_model", "worker_acceptance_path", "worker_acceptance_sha256", "input_model", "authorization"],
  "properties": {
    "schema_version": {"const": "0verse.macho-campaign/v1"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "target": {"$ref": "#/$defs/macho"},
    "control": {"$ref": "#/$defs/macho"},
    "coordinator": {"$ref": "#/$defs/identifier"},
    "worker": {"$ref": "#/$defs/identifier"},
    "hardware_model": {"$ref": "#/$defs/hardwareModel"},
    "worker_acceptance_path": {"$ref": "#/$defs/relativePath"},
    "worker_acceptance_sha256": {"$ref": "#/$defs/sha256"},
    "input_model": {"type": "string", "minLength": 1},
    "authorization": {"$ref": "#/$defs/authorization"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "cdhash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uuid": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "hardwareModel": {"type": "string", "pattern": "^[A-Za-z]+[0-9]+,[0-9]+$"},
    "build": {"type": "string", "pattern": "^[0-9]{2}[A-Z][0-9]{2,4}[a-z]?$"},
    "relativePath": {"type": "string", "pattern": "^(?!\\.{1,2}$)(?!\\.{1,2}/)(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"},
    "absolutePath": {"type": "string", "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0}}
    },
    "macho": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "macho_uuid", "code_signature_sha256", "cdhash", "signing_identifier", "team_identifier", "architecture", "product_name", "product_version", "product_build"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"},
        "macho_uuid": {"$ref": "#/$defs/uuid"}, "code_signature_sha256": {"$ref": "#/$defs/sha256"},
        "cdhash": {"$ref": "#/$defs/cdhash"}, "signing_identifier": {"type": "string", "minLength": 1},
        "team_identifier": {"type": "string", "minLength": 1}, "architecture": {"enum": ["arm64", "arm64e", "x86_64"]},
        "product_name": {"type": "string", "minLength": 1}, "product_version": {"type": "string", "minLength": 1},
        "product_build": {"$ref": "#/$defs/build"}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "target_sha256", "target_uuid", "control_sha256", "control_uuid", "target_identity_sha256", "control_identity_sha256", "coordinator", "worker", "hardware_model", "input_model", "kind", "scope_url", "scope_evidence", "scope_checked_at", "expires_at", "statement", "authorized_by", "authority_key_sha256", "signature_ssh"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/identifier"}, "target_sha256": {"$ref": "#/$defs/sha256"},
        "target_uuid": {"$ref": "#/$defs/uuid"}, "control_sha256": {"$ref": "#/$defs/sha256"},
        "control_uuid": {"$ref": "#/$defs/uuid"}, "coordinator": {"$ref": "#/$defs/identifier"}, "worker": {"$ref": "#/$defs/identifier"},
        "target_identity_sha256": {"$ref": "#/$defs/sha256"}, "control_identity_sha256": {"$ref": "#/$defs/sha256"},
        "hardware_model": {"$ref": "#/$defs/hardwareModel"}, "input_model": {"type": "string", "minLength": 1}, "kind": {"enum": ["published-bounty", "written-authorization", "owned-lab"]},
        "scope_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "scope_evidence": {"$ref": "#/$defs/artifact"},
        "scope_checked_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
        "statement": {"type": "string", "minLength": 1}, "authorized_by": {"$ref": "#/$defs/identifier"},
        "authority_key_sha256": {"$ref": "#/$defs/sha256"},
        "signature_ssh": {"type": "string", "minLength": 1, "maxLength": 65536}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "published-bounty"}}}, "then": {"properties": {"scope_url": {"type": "string", "format": "uri", "pattern": "^https://security\\.apple\\.com(?:/|$)"}}}}
      ]
    }
  }
}
