## Autotools listing for the pwnkit Tier-2 reference target.
## The Tier-2 builder grep-parses this file to discover sibling
## sources for the suspect translation unit.

lib_LTLIBRARIES = libpwnkit_tier2.la

libpwnkit_tier2_la_SOURCES = \
    src/api.c \
    src/frame.c \
    src/decoder.c

libpwnkit_tier2_la_CFLAGS = -Wall -Wextra -I$(top_srcdir)/include
