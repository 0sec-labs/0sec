# Strategy / marketing / launch / fundraising / pitch material lives in
# the business repo at ~/coding/business/opensoar-hq-strategy/, not here.
# These patterns are kept so any stale local-only files don't accidentally
# end up tracked again.
.internal/
.local/
marketing/
