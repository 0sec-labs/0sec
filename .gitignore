www/
dist-npm/

# Release-staging binary artifacts — operator builds these locally
# via packages/core/src/triage/kernel-vm/build.sh and uploads to the
# 0sec-labs/pwnkit-kernel-artifacts GitHub release. Only the metadata
# (SHA256SUMS, PUBLISH.md, *.patch) is committed.
release-staging/*/bzImage
release-staging/*/rootfs.img
release-staging/*/kernel.config
release-staging/*/pwnkit_vm_key
release-staging/*/pwnkit_vm_key.pub
